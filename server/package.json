{
  "name": "the-furnace-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "temporal:worker": "tsx --env-file=.env src/temporal/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:container-as-worker:e2e": "tsx scripts/test-container-as-worker-e2e.ts",
    "ui:build": "vite build",
